{
  "versao": 1,
  "tema": "Adoção de Pets",
  "descricao": "Usuários cadastram animais para adoção. Qualquer pessoa vê os animais; só quem cadastrou altera ou remove. Usuários logados fazem pedidos de adoção, e só o dono do animal decide sobre eles.",
  "rotas": [
    {
      "metodo": "GET",
      "caminho": "/animais",
      "acesso": "aberto",
      "descricao": "Lista todos os animais.",
      "exemplos": [
        {
          "descricao": "Lista os animais",
          "requisicao": null,
          "resposta": [
            { "id": 1, "nome": "Rex", "especie": "cachorro", "idade": 3, "descricao": "Brincalhão e vacinado", "status": "disponivel", "usuarioId": 3 }
          ],
          "status": 200
        }
      ]
    },
    {
      "metodo": "GET",
      "caminho": "/animais/:id",
      "acesso": "aberto",
      "descricao": "Detalha um animal.",
      "exemplos": [
        {
          "descricao": "Animal existe",
          "requisicao": null,
          "resposta": { "id": 1, "nome": "Rex", "especie": "cachorro", "idade": 3, "descricao": "Brincalhão e vacinado", "status": "disponivel", "usuarioId": 3 },
