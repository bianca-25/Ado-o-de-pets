        },
        {
          "descricao": "Animal não existe",
          "requisicao": null,
          "resposta": { "erro": "Animal não encontrado" },
          "status": 404
        }
      ]
    },
    {
      "metodo": "POST",
      "caminho": "/animais",
      "acesso": "logado",
      "descricao": "Cadastra um animal. O dono é quem está logado.",
      "exemplos": [
        {
          "descricao": "Dados válidos",
          "requisicao": { "nome": "Rex", "especie": "cachorro", "idade": 3, "descricao": "Brincalhão e vacinado" },
          "resposta": { "id": 1, "nome": "Rex", "especie": "cachorro", "idade": 3, "descricao": "Brincalhão e vacinado", "status": "disponivel", "usuarioId": 3 },
          "status": 201
        },
        {
          "descricao": "Falta a espécie",
          "requisicao": { "nome": "Rex", "idade": 3 },
          "resposta": { "erro": "Campo obrigatório ausente: especie" },
          "status": 400
        },
        {
          "descricao": "Idade negativa",
          "requisicao": { "nome": "Rex", "especie": "cachorro", "idade": -2 },
