        {
          "descricao": "Sem token",
          "requisicao": { "nome": "Rex", "especie": "cachorro", "idade": 3 },
          "resposta": { "erro": "Token ausente ou inválido" },
          "status": 401
        }
      ]
    },
    {
      "metodo": "PUT",
      "caminho": "/animais/:id",
      "acesso": "dono",
      "descricao": "Altera um animal. Só o dono pode.",
